# ==========================================
# Visual Studio 2019 & MSVC
# ==========================================
.vs/
*.user
*.userosv
*.suo
*.sln.docstates
*.vcxproj.user
# Written by Visual Studio when it opens the folder directly; local IntelliSense
# configuration, not part of the build.
CppProperties.json
CMakeUserPresets.json
vcpkg_installed/

# Visual Studio Build Outputs & Folders
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
x64/
x86/
out/
# CMake-generated build trees. These bake in absolute paths from the machine
# that generated them, so they are never portable between clones - regenerate
# locally instead (see README.md).
[Bb]uild/
# The knowledge bundle's build folder is documentation, not a build tree.
!docs/build/

# MSVC Compiled Artifacts
*.obj
*.exe
*.dll
*.lib
*.pdb
*.idb
*.ilk
*.exp
*.res
*.pch
*.tlog
*.lastbuildstate
*.log

# ==========================================
# CMake Generated Files
# ==========================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
/compile_commands.json
.cache
tools/web/browser-tests/target/

# ==========================================
# OS & Backup Files
# ==========================================
# macOS
.DS_Store
*.dSYM/

# Windows
Thumbs.db
desktop.ini

# Backup files
*.bak
*_bak*
*.old

# General Compiled Binaries
*.o
*.a
*.so
*.dylib
__pycache__/

# Scratch files written by the file I/O unit tests. They are created in
# the working directory, which is the build directory under CTest but the
# repository root when the test binary is run by hand.
*_test.bin
