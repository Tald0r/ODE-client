{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "VS2022 x64 with all tests",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/presets/windows",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "REQUIRE_TEST_TOOLS": "ON",
        "USE_ASAN": "OFF",
        "USE_TSAN": "OFF",
        "USE_UBSAN": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/presets/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "VS2022 x64 with AddressSanitizer and all tests",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/presets/windows-asan",
      "cacheVariables": { "USE_ASAN": "ON" }
    },
    {
      "name": "windows-clang",
      "displayName": "clang-cl (VS developer prompt), NMake, all tests",
      "generator": "NMake Makefiles",
      "binaryDir": "${sourceDir}/build/presets/windows-clang",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "BUILD_TESTS": "ON",
        "REQUIRE_TEST_TOOLS": "ON",
        "USE_ASAN": "OFF",
        "USE_TSAN": "OFF",
        "USE_UBSAN": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/presets/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux GCC, Ninja, Debug, all tests (system SDL2 or vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/presets/linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTS": "ON",
        "REQUIRE_TEST_TOOLS": "ON",
        "USE_ASAN": "OFF",
        "USE_TSAN": "OFF",
        "USE_UBSAN": "OFF"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux GCC with AddressSanitizer and UndefinedBehaviorSanitizer, all tests",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/presets/linux-asan",
      "cacheVariables": { "USE_ASAN": "ON", "USE_UBSAN": "ON" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang, Ninja, Debug, all tests",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/presets/linux-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS Clang, Ninja, Debug, all tests (Homebrew or vcpkg SDL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/presets/macos",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_PREFIX_PATH": "/opt/homebrew;/usr/local",
        "BUILD_TESTS": "ON",
        "REQUIRE_TEST_TOOLS": "ON",
        "USE_ASAN": "OFF",
        "USE_TSAN": "OFF",
        "USE_UBSAN": "OFF"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS Clang with AddressSanitizer and UndefinedBehaviorSanitizer, all tests",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/presets/macos-asan",
      "cacheVariables": { "USE_ASAN": "ON", "USE_UBSAN": "ON" }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux Clang with ASan, UBSan and the libFuzzer targets (needs the libclang-rt package)",
      "inherits": "linux-clang",
      "binaryDir": "${sourceDir}/build/presets/linux-fuzz",
      "cacheVariables": { "USE_ASAN": "ON", "USE_UBSAN": "ON", "BUILD_FUZZERS": "ON" }
    },
    {
      "name": "macos-fuzz",
      "displayName": "macOS Apple Clang with ASan, UBSan and the libFuzzer targets, linking Homebrew llvm@21's libFuzzer",
      "inherits": "macos-asan",
      "binaryDir": "${sourceDir}/build/presets/macos-fuzz",
      "cacheVariables": {
        "BUILD_FUZZERS": "ON",
        "DARKEDEN_LIBFUZZER_ARCHIVE": "/opt/homebrew/opt/llvm@21/lib/clang/21/lib/darwin/libclang_rt.fuzzer_osx.a"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 2 },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "jobs": 2 },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "Debug", "jobs": 2 },
    { "name": "windows-clang", "configurePreset": "windows-clang" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "macos-asan", "configurePreset": "macos-asan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" },
    { "name": "macos-fuzz", "configurePreset": "macos-fuzz" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    {
      "name": "windows-release",
      "inherits": "windows-debug",
      "configuration": "Release"
    },
    {
      "name": "windows-asan",
      "inherits": "windows-debug",
      "configurePreset": "windows-asan"
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    { "name": "linux-asan", "inherits": "linux", "configurePreset": "linux-asan" },
    { "name": "linux-clang", "inherits": "linux", "configurePreset": "linux-clang" },
    { "name": "macos", "inherits": "linux", "configurePreset": "macos" },
    { "name": "macos-asan", "inherits": "linux", "configurePreset": "macos-asan" },
    { "name": "linux-fuzz", "inherits": "linux", "configurePreset": "linux-fuzz" },
    { "name": "macos-fuzz", "inherits": "linux", "configurePreset": "macos-fuzz" }
  ]
}
